# Copy to .env and adjust as needed. Everything has a working local default,
# so this file is optional for local development.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# --- Database -----------------------------------------------------------
# Local development uses SQLite (backend/db.sqlite3) by default.
# For Postgres, set DATABASE_URL...
# DATABASE_URL=postgres://user:password@host:5432/dbname

# ...or set DB_ENGINE=postgres plus the individual values:
# DB_ENGINE=postgres
# POSTGRES_DB=kwabenya_spares
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# --- Demo / auth --------------------------------------------------------
# One-click demo login buttons on login.html (disable in production).
ALLOW_DEMO_LOGIN=True
DEMO_PASSWORD=demo1234

# --- Frontend -----------------------------------------------------------
# Django serves this folder in DEBUG so one `runserver` hosts site + API.
# FRONTEND_DIR=C:\path\to\motoparts-site-main\motoparts-site-main

# --- CORS ---------------------------------------------------------------
# Local dev allows every origin. In production set this to your site's URL.
# CORS_ALLOW_ALL_ORIGINS=False
# CORS_ALLOWED_ORIGINS=https://your-site.netlify.app
