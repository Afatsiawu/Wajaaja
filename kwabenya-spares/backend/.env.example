DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# Database engine: postgres (default) or sqlite (local dev without Postgres)
# DB_ENGINE=postgres

# Either set DATABASE_URL (provided automatically by Render)...
# DATABASE_URL=postgres://user:password@host:5432/dbname

# ...or set these individually (postgres):
POSTGRES_DB=kwabenya_spares
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# For local SQLite testing instead:
# DB_ENGINE=sqlite

# Frontend origin (Vercel URL) — added to CORS allowed origins
FRONTEND_URL=https://your-frontend.vercel.app

# Comma-separated list of allowed frontend origins (optional if FRONTEND_URL set)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173